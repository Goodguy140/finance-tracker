# next-auth@4 declares an *optional* peer dependency on nodemailer@^7, but this app
# does not use next-auth's Email provider — it sends mail via src/lib/email.ts. We
# intentionally run nodemailer@9 (security fixes), which is outside that stale peer
# range, so allow the mismatch instead of failing strict installs (`npm ci`).
legacy-peer-deps=true
