{
  "expo": {
    "name": "Finances",
    "slug": "finance-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.goodguy140.financetracker",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.intuit.ofx",
            "UTTypeDescription": "OFX bank statement",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ofx"
              ],
              "public.mime-type": [
                "application/x-ofx"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.intuit.qfx",
            "UTTypeDescription": "QFX bank statement",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "qfx"
              ],
              "public.mime-type": [
                "application/vnd.intu.qfx"
              ]
            }
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Finances opens your photos only when you choose a receipt to keep with an entry.",
          "cameraPermission": "Finances uses the camera only when you take a photo of a receipt to keep with an entry.",
          "microphonePermission": "Finances takes still photos of receipts only and never records sound."
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finances uses Face ID to unlock the app when you turn on the lock in Settings."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/share-statements",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": "SUBQUERY (extensionItems, $extensionItem, SUBQUERY ($extensionItem.attachments, $attachment, ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.image\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.adobe.pdf\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.comma-separated-values-text\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.intuit.ofx\" || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.intuit.qfx\").@count == 1).@count == 1"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "SafeToSpend",
              "displayName": "Safe to Spend",
              "description": "What you can spend for the rest of the month, as of the last time you opened Finances.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/safe-to-spend.tsx"
              }
            },
            {
              "name": "BillsAndPay",
              "displayName": "Bills and Pay",
              "description": "Bills and paydays coming up in the next week, as of the last time you opened Finances.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/bills.tsx"
              }
            }
          ]
        }
      ],
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents",
          "passkeys"
        ]
      }
    },
    "owner": "goodguy140",
    "extra": {
      "eas": {
        "projectId": "35c86e32-7384-47ec-b5e5-1a999ffaa852"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/35c86e32-7384-47ec-b5e5-1a999ffaa852"
    }
  }
}
