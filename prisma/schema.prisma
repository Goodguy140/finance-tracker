// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SERVER_ADMIN
  USER
}

enum AccountType {
  CHEQUING
  SAVINGS
  CREDIT_CARD
  TFSA
  RRSP
  FHSA
  NON_REGISTERED
  CASH
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum RecurringCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  BIENNIAL
}

enum RecurringPostMode {
  REVIEW
  AUTO
}

enum InvestmentFlowDirection {
  CONTRIBUTION
  WITHDRAWAL
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String?
  displayName             String
  timezone                String    @default("America/Toronto")
  countryCode             String    @default("CA")
  emailVerifiedAt         DateTime?
  role                    UserRole  @default(USER)
  /**
   * When set, the Add Expense form preselects this account (must be one of the user's accounts).
   */
  defaultExpenseAccountId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  defaultExpenseAccount Account? @relation("UserDefaultExpenseAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)

  authAccounts          AuthAccount[]
  sessions              Session[]
  resetTokens           PasswordResetToken[]
  personalAccessTokens  PersonalAccessToken[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  splitTransaction      SplitTransactionPart[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  investmentFlows       InvestmentFlow[]
  portfolioSnapshots    PortfolioSnapshot[]
  updatedServerConfig   ServerSetting[]        @relation("ServerSettingUpdatedBy")
  auditLogs             AuditLog[]
  subscriptionMembers       SubscriptionMember[]
  subscriptionShareStatuses SubscriptionShareStatus[]
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  targetType   String?
  targetId     String?
  metadataJson String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal access token for programmatic API access (e.g. the Life Dashboard).
/// Only the SHA-256 hash of the raw token is stored; the raw value is shown once.
model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ServerSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  encryptedValue  String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("ServerSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model Account {
  id          String      @id @default(cuid())
  userId      String
  name        String
  type        AccountType
  currency    String      @default("CAD")
  countryCode String      @default("CA")
  provider    String?
  /**
   * Hidden from pickers on the dashboard and in import defaults; past data unchanged.
   */
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultExpenseForUsers User[]                 @relation("UserDefaultExpenseAccount")
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  investmentFlows        InvestmentFlow[]
  portfolioSnapshots     PortfolioSnapshot[]
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  splitParts            SplitTransactionPart[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, kind])
}

model Transaction {
  id                     String          @id @default(cuid())
  userId                 String
  accountId              String?
  categoryId             String
  type                   TransactionType
  amountCents            Int
  /**
   * Purchase total before credits/rewards (optional; net outflow stays in amountCents).
   */
  preCreditCents         Int?
  /**
   * Credits, rewards, or discounts applied (positive cents; subtracted from pre-credit total).
   */
  creditCents            Int?
  /**
   * Optional JSON array of per-credit cents to preserve distinct credit lines across edits.
   */
  creditBreakdownJson    String?
  title                  String?
  date                   DateTime
  postedDate             DateTime?
  accountDescription     String?
  note                   String?
  recurringTransactionId String?
  recurringExpectedDate  DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category   Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  splitParts SplitTransactionPart[]

  @@unique([userId, recurringTransactionId, recurringExpectedDate])
}

model SplitTransactionPart {
  id            String @id @default(cuid())
  userId        String
  transactionId String
  categoryId    String
  amountCents   Int

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  name        String?
  periodMonth String
  limitCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, periodMonth])
}

model RecurringTransaction {
  id               String            @id @default(cuid())
  userId           String
  accountId        String
  categoryId       String
  type             TransactionType
  name             String
  amountCents      Int
  cadence          RecurringCadence
  nextExpectedDate DateTime
  endDate          DateTime?
  postMode         RecurringPostMode @default(REVIEW)
  enabled          Boolean           @default(true)
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subscriptionMembers       SubscriptionMember[]
  subscriptionShareStatuses SubscriptionShareStatus[]

  @@index([userId, enabled, nextExpectedDate])
  @@index([userId, type])
}

/// A person who shares the cost of a subscription (a recurring expense rule).
model SubscriptionMember {
  id                     String   @id @default(cuid())
  userId                 String
  recurringTransactionId String
  name                   String
  /// This person's fixed portion of the bill, in cents. Credited to the posted expense when they pay.
  shareCents             Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction      @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  shareStatuses        SubscriptionShareStatus[]

  @@index([userId])
  @@index([recurringTransactionId])
}

/// Per-billing-occurrence tracking of whether a member was sent the bill and has paid.
model SubscriptionShareStatus {
  id                     String    @id @default(cuid())
  userId                 String
  memberId               String
  recurringTransactionId String
  /// The billing occurrence; matches Transaction.recurringExpectedDate for the posted expense.
  expectedDate           DateTime
  billSent               Boolean   @default(false)
  paid                   Boolean   @default(false)
  paidAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  member               SubscriptionMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@unique([memberId, expectedDate])
  @@index([userId])
  @@index([recurringTransactionId, expectedDate])
}

model InvestmentFlow {
  id          String                  @id @default(cuid())
  userId      String
  accountId   String
  date        DateTime
  direction   InvestmentFlowDirection
  amountCents Int
  note        String?
  createdAt   DateTime                @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model PortfolioSnapshot {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  date            DateTime
  totalValueCents Int
  note            String?
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model RateLimitEntry {
  key     String   @id
  count   Int
  resetAt DateTime
}
