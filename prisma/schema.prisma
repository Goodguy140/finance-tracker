// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SERVER_ADMIN
  USER
}

enum AccountType {
  CHEQUING
  SAVINGS
  CREDIT_CARD
  TFSA
  RRSP
  FHSA
  NON_REGISTERED
  CASH
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionRuleTextOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
}

enum RecurringCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  BIENNIAL
}

enum RecurringPostMode {
  REVIEW
  AUTO
}

enum InvestmentFlowDirection {
  CONTRIBUTION
  WITHDRAWAL
}

enum PlaidItemStatus {
  ACTIVE
  /// ITEM_LOGIN_REQUIRED — the bank needs the user to re-authenticate before syncing again.
  LOGIN_REQUIRED
  ERROR
  /// /item/remove succeeded; the row is kept briefly so the audit trail has something to point at.
  REMOVED
}

enum PlaidStagedStatus {
  NEEDS_REVIEW
  /// Attached to a Transaction the user had already entered by hand.
  LINKED
  /// Created a new Transaction.
  ADDED
  /// User declined it. Sticky: a re-sync must never re-propose it.
  IGNORED
  /// Plaid withdrew the record before the user decided anything.
  REMOVED_BY_PLAID
  /// A pending row whose posted successor took over.
  SUPERSEDED
}

enum TransactionVerificationSource {
  /// The Transaction was created from the bank record.
  IMPORTED
  /// A hand-entered Transaction the user linked to a bank record.
  MATCHED
}

model User {
  id                            String    @id @default(cuid())
  email                         String    @unique
  passwordHash                  String?
  displayName                   String
  timezone                      String    @default("America/Toronto")
  countryCode                   String    @default("CA")
  emailVerifiedAt               DateTime?
  role                          UserRole  @default(USER)
  /**
   * Bumped whenever every existing session should stop working (password change, password
   * reset, explicit sign-out-everywhere). Sessions are stateless JWTs, so this is the only
   * revocation channel: a token carries the version it was issued with and is rejected once
   * it no longer matches. Tokens issued before this column existed carry no version and are
   * treated as 0, so deploying it does not sign everyone out.
   */
  tokenVersion                  Int       @default(0)
  /**
   * Set when an admin suspends the account. A suspended user keeps all their financial
   * history but cannot sign in, hold a session, or use a personal access token — the
   * de-provisioning step for someone who has left, without destroying their data. Suspending
   * also bumps `tokenVersion`, so live sessions stop at the next request rather than at expiry.
   */
  disabledAt                    DateTime?
  /**
   * When set, the Add Expense form preselects this account (must be one of the user's accounts).
   */
  defaultExpenseAccountId       String?
  /**
   * Email the account address when a monthly budget crosses its warning or over-budget
   * threshold. Server-side so the alert can be sent from whichever request pushed the
   * category over, not only from a browser that happens to be open.
   */
  budgetAlertEmailEnabled       Boolean   @default(false)
  /**
   * How much text the dashboard must keep readable before it merges a column away, as whole
   * percentages. The first applies to each card's text as a whole; the second to each budget
   * name on its own, which is the point of its row and so gets a floor of its own.
   */
  dashboardTextVisiblePct       Int       @default(95)
  dashboardBudgetNameVisiblePct Int       @default(90)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  defaultExpenseAccount Account? @relation("UserDefaultExpenseAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)

  authAccounts              AuthAccount[]
  sessions                  Session[]
  resetTokens               PasswordResetToken[]
  personalAccessTokens      PersonalAccessToken[]
  webAuthnCredentials       WebAuthnCredential[]
  mfaChallenges             MfaChallenge[]
  recoveryCodes             RecoveryCode[]
  accounts                  Account[]
  categories                Category[]
  transactions              Transaction[]
  splitTransaction          SplitTransactionPart[]
  budgets                   Budget[]
  recurringTransactions     RecurringTransaction[]
  investmentFlows           InvestmentFlow[]
  portfolioSnapshots        PortfolioSnapshot[]
  updatedServerConfig       ServerSetting[]           @relation("ServerSettingUpdatedBy")
  auditLogs                 AuditLog[]
  subscriptionMembers       SubscriptionMember[]
  subscriptionShareStatuses SubscriptionShareStatus[]
  budgetAlertNotifications  BudgetAlertNotification[]
  plaidItems                PlaidItem[]
  plaidAccounts             PlaidAccount[]
  plaidStagedTransactions   PlaidStagedTransaction[]
  transactionVerifications  TransactionVerification[]
  dashboardLayout           DashboardLayout?
  transactionRules          TransactionRule[]
  hiddenTitleSuggestions    HiddenTitleSuggestion[]
  insightDismissals         InsightDismissal[]
  insightPreference         InsightPreference?
}

/**
 * The desktop dashboard layout for one user: column widths, which card sits where, which
 * cards are stacked together, and each card's own settings — all one validated JSON blob
 * (`dashboardLayoutSchema` in src/lib/dashboard-layout/schema.ts).
 * Its own table rather than a column on User: it is rewritten on every drag and read by
 * exactly one page, so it has no business widening the row that every authenticated
 * request loads. A new table also needs no REQUIRED_SCHEMA_COLUMNS / COLUMN_REPAIRS entry
 * and no SCHEMA_REPAIR_VERSION bump, which a new column on User would have.
 * Deliberately excluded from the user backup — see the exclusions note in src/lib/backup.ts.
 */
model DashboardLayout {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// TEXT, not Json: the SQLite datasource has no native JSON type.
  layoutJson String
  /**
   * Mirrors the `version` inside layoutJson. Duplicated as a column so a future migration
   * sweep can find stale blobs without parsing every row.
   */
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * One row per budget alert email actually sent, so a category that stays over its limit
 * for the rest of the month is announced once per severity, not on every expense.
 */
model BudgetAlertNotification {
  id          String   @id @default(cuid())
  userId      String
  periodMonth String
  categoryId  String
  severity    String
  sentAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodMonth, categoryId, severity])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  targetType   String?
  targetId     String?
  metadataJson String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  // The review UI filters by action or actor and always orders by time; the single-column
  // indexes above leave that as a filter-then-sort over everything the filter matched.
  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal access token for programmatic API access (e.g. the Life Dashboard).
/// Only the SHA-256 hash of the raw token is stored; the raw value is shown once.
model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * A registered passkey (WebAuthn credential). Having at least one row turns the passkey
 * second factor on for every sign-in. `credentialId` and `publicKey` are base64url strings
 * exactly as the browser reports them; the public key is not secret, but the row is still
 * excluded from user backups because a credential is bound to this RP origin and restoring
 * someone else's credential list into an account would be a takeover vector.
 */
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String?
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * One-shot server-side state for a WebAuthn ceremony (or an SSO link intent). Rows are
 * deleted the moment they are consumed and expire after a few minutes regardless.
 * `userId` is null for passwordless sign-in challenges, where no session exists yet.
 */
model MfaChallenge {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Single-use recovery codes (bcrypt-hashed) issued alongside the first passkey.
 */
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ServerSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  encryptedValue  String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("ServerSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model Account {
  id          String      @id @default(cuid())
  userId      String
  name        String
  type        AccountType
  currency    String      @default("CAD")
  countryCode String      @default("CA")
  provider    String?
  /**
   * Hidden from pickers on the dashboard and in import defaults; past data unchanged.
   */
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultExpenseForUsers User[]                 @relation("UserDefaultExpenseAccount")
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  investmentFlows        InvestmentFlow[]
  portfolioSnapshots     PortfolioSnapshot[]
  plaidAccounts          PlaidAccount[]
  rulesMatchingAccount   TransactionRule[]      @relation("TransactionRuleMatchAccount")
  rulesSettingAccount    TransactionRule[]      @relation("TransactionRuleSetAccount")
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  splitParts            SplitTransactionPart[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  plaidItemDefaults     PlaidItem[]
  transactionRules      TransactionRule[]

  @@unique([userId, name, kind])
}

model Transaction {
  id                     String          @id @default(cuid())
  userId                 String
  accountId              String?
  categoryId             String
  type                   TransactionType
  amountCents            Int
  /**
   * Purchase total before credits/rewards (optional; net outflow stays in amountCents).
   */
  preCreditCents         Int?
  /**
   * Credits, rewards, or discounts applied (positive cents; subtracted from pre-credit total).
   */
  creditCents            Int?
  /**
   * Optional JSON array of per-credit cents to preserve distinct credit lines across edits.
   */
  creditBreakdownJson    String?
  title                  String?
  date                   DateTime
  postedDate             DateTime?
  accountDescription     String?
  note                   String?
  recurringTransactionId String?
  recurringExpectedDate  DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?                 @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category     Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  splitParts   SplitTransactionPart[]
  verification TransactionVerification?

  @@unique([userId, recurringTransactionId, recurringExpectedDate])
  /// The dashboard runs four `userId + type + date` range queries per page load and the
  /// Plaid matcher scans one date window per sync; the unique above only offers a `userId`
  /// prefix, leaving both as a filter-then-sort over everything that user owns.
  @@index([userId, date])
}

model SplitTransactionPart {
  id            String @id @default(cuid())
  userId        String
  transactionId String
  categoryId    String
  amountCents   Int

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  name        String?
  periodMonth String
  limitCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, periodMonth])
}

model RecurringTransaction {
  id               String            @id @default(cuid())
  userId           String
  accountId        String
  categoryId       String
  type             TransactionType
  name             String
  amountCents      Int
  cadence          RecurringCadence
  nextExpectedDate DateTime
  endDate          DateTime?
  postMode         RecurringPostMode @default(REVIEW)
  enabled          Boolean           @default(true)
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subscriptionMembers       SubscriptionMember[]
  subscriptionShareStatuses SubscriptionShareStatus[]

  @@index([userId, enabled, nextExpectedDate])
  @@index([userId, type])
}

/// A person who shares the cost of a subscription (a recurring expense rule).
model SubscriptionMember {
  id                     String   @id @default(cuid())
  userId                 String
  recurringTransactionId String
  name                   String
  /// This person's fixed portion of the bill, in cents. Credited to the posted expense when they pay.
  shareCents             Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction      @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  shareStatuses        SubscriptionShareStatus[]

  @@index([userId])
  @@index([recurringTransactionId])
}

/// Per-billing-occurrence tracking of whether a member was sent the bill and has paid.
model SubscriptionShareStatus {
  id                     String    @id @default(cuid())
  userId                 String
  memberId               String
  recurringTransactionId String
  /// The billing occurrence; matches Transaction.recurringExpectedDate for the posted expense.
  expectedDate           DateTime
  billSent               Boolean   @default(false)
  paid                   Boolean   @default(false)
  paidAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  member               SubscriptionMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@unique([memberId, expectedDate])
  @@index([userId])
  @@index([recurringTransactionId, expectedDate])
}

model InvestmentFlow {
  id          String                  @id @default(cuid())
  userId      String
  accountId   String
  date        DateTime
  direction   InvestmentFlowDirection
  amountCents Int
  note        String?
  createdAt   DateTime                @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model PortfolioSnapshot {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  date            DateTime
  totalValueCents Int
  note            String?
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model RateLimitEntry {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// One linked bank connection (Plaid calls it an Item). Holds the credential that lets the
/// server pull that bank's transactions, so it is the most sensitive row in the database
/// after the password hash — encrypted at rest and never exported in a backup.
model PlaidItem {
  id                      String          @id @default(cuid())
  userId                  String
  /// Plaid's item_id. Unique at Plaid and here, so re-linking the same bank is caught.
  itemId                  String          @unique
  /// AES-256-GCM via encryptSecret(). Never logged, never a form value, never exported.
  accessTokenEnc          String
  institutionId           String?
  institutionName         String?
  /// /transactions/sync cursor. NULL means never synced, so the first call walks full history.
  cursor                  String?
  status                  PlaidItemStatus @default(ACTIVE)
  errorCode               String?
  errorMessage            String?
  consentExpiresAt        DateTime?
  /// What the user asked for at link time: 30, 90, 365 or 730.
  requestedDays           Int
  /// UTC midnight, resolved once at link time and never recomputed. The UI states this exact
  /// date rather than deriving it, so what the user was promised cannot drift.
  historyCutoff           DateTime
  /// Earliest date the institution actually returned. NULL until the first full sync ends;
  /// later than historyCutoff means the bank gave us less than was asked for.
  earliestObservedAt      DateTime?
  initialSyncDoneAt       DateTime?
  lastSyncedAt            DateTime?
  lastSyncError           String?
  /// Reset to 0 on any successful sync. Drives how far the next retry is pushed out.
  consecutiveSyncFailures Int             @default(0)
  /// Earliest the sweep may try this bank again. NULL means "whenever it is next due".
  /// Without it a permanently broken connection is retried every hour forever, which
  /// spends rate limit and, on per-request pricing, money — for a call that cannot work.
  nextSyncAttemptAt       DateTime?
  /// Set while a sync is in flight. A value older than the stale threshold is ignored, so a
  /// crashed sync cannot wedge the item forever.
  syncingSince            DateTime?
  /// Set by a PENDING_EXPIRATION webhook: the user's consent ends soon (date in
  /// consentExpiresAt). Cleared when update mode completes or LOGIN_REPAIRED arrives.
  pendingExpirationAt     DateTime?
  /// Set by a PENDING_DISCONNECT webhook: the bank will stop sharing data soon unless the
  /// user goes through update mode. Cleared the same way as pendingExpirationAt.
  pendingDisconnectAt     DateTime?
  /// Plaid's `reason` for the pending disconnect, e.g. INSTITUTION_TOKEN_EXPIRATION.
  pendingDisconnectReason String?
  /// Set by NEW_ACCOUNTS_AVAILABLE. Cleared when account-selection update mode completes.
  newAccountsAvailableAt  DateTime?
  /// The webhook URL Plaid holds for this item. Compared on sync so items linked before
  /// webhooks existed, or before the public URL changed, are re-pointed once.
  webhookUrl              String?
  /// Per-item fallback when the personal_finance_category map does not hit.
  defaultCategoryId       String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?                @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  plaidAccounts   PlaidAccount[]
  stagedRows      PlaidStagedTransaction[]

  @@index([userId])
  /// The sweep's "which items are due" query.
  @@index([status, lastSyncedAt])
}

/// One account inside a linked bank, and the app Account it feeds. Plaid's own type/subtype
/// are kept verbatim rather than mapped onto AccountType: they are a much larger vocabulary,
/// and guessing wrong would silently misfile transactions.
model PlaidAccount {
  id             String  @id @default(cuid())
  userId         String
  plaidItemId    String
  plaidAccountId String
  name           String
  officialName   String?
  mask           String?
  plaidType      String
  plaidSubtype   String?
  currency       String?
  /// NULL until the user maps it. An unmapped account is not synced.
  accountId      String?
  syncEnabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem               PlaidItem                @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  account                 Account?                 @relation(fields: [accountId], references: [id], onDelete: SetNull)
  plaidStagedTransactions PlaidStagedTransaction[]

  @@unique([userId, plaidAccountId])
  @@index([plaidItemId])
  @@index([accountId])
}

/// A transaction pulled from the bank that has not been committed to the log yet.
///
/// Nothing here is visible in the expense or income log: the user decides per row whether to
/// link it to something they already entered, add it as new, or ignore it. Rows are kept
/// while the connection lives, including IGNORED ones — the (userId, plaidTransactionId)
/// pair is the idempotency key for the whole feature, so pruning would let a re-sync
/// re-propose transactions the user has already declined. The exceptions are
/// REMOVED_BY_PLAID and SUPERSEDED, whose ids Plaid never re-issues: they are deleted after
/// a grace period (`pruneSpentStagedRows`). Unlinking, or the user revoking consent at
/// Plaid, deletes all of a connection's rows (`purgePlaidItemData`).
model PlaidStagedTransaction {
  id                        String  @id @default(cuid())
  userId                    String
  plaidItemId               String
  plaidAccountRowId         String
  plaidTransactionId        String
  /// Plaid's pending_transaction_id: the pending row this posted row replaces.
  pendingPlaidTransactionId String?
  isPending                 Boolean @default(false)

  name         String
  merchantName String?
  /// Sign already resolved to this app's semantics: positive for an outflow, negative for a
  /// refund staged as an expense credit. Income rows are always positive.
  amountCents  Int
  type         TransactionType
  currency     String?
  date         DateTime
  postedDate   DateTime?
  pfcPrimary   String?
  pfcDetailed  String?

  suggestedCategoryId String?
  suggestedAccountId  String?
  status              PlaidStagedStatus @default(NEEDS_REVIEW)

  matchTransactionId String?
  matchScore         Int?
  matchTier          String?
  /// JSON array of human-readable reasons, shown under the proposed match.
  matchReasonsJson   String?

  resolvedTransactionId String?
  resolvedAt            DateTime?
  /// Plaid revised a row the user had already committed. The new values live in the columns
  /// above; the committed Transaction is never rewritten without a click.
  revisedAfterResolveAt DateTime?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem    PlaidItem    @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccount PlaidAccount @relation(fields: [plaidAccountRowId], references: [id], onDelete: Cascade)

  @@unique([userId, plaidTransactionId])
  @@index([userId, status, date])
  /// Pending → posted lookup.
  @@index([pendingPlaidTransactionId])
  /// The dashboard asks for revised-but-already-committed rows on every load. Staged rows
  /// are kept for the life of the connection (they are the idempotency key), so without
  /// this the query scans a range that only grows, to find a column that is almost always
  /// null.
  @@index([userId, revisedAfterResolveAt])
}

/// Marks a Transaction as confirmed against a bank record — what the Verified badge reads.
///
/// A separate table rather than columns on Transaction: the data is sparse (only verified
/// rows), and Transaction is the one table whose columns must also be mirrored in
/// REQUIRED_SCHEMA_COLUMNS, the repair script, and the backup payload.
model TransactionVerification {
  id                 String                        @id @default(cuid())
  userId             String
  transactionId      String                        @unique
  source             TransactionVerificationSource
  /// NULL on a restored backup: exports carry the fact of verification but no Plaid ids,
  /// which are meaningless outside the deployment that created them. Also NULL once the
  /// connection is unlinked — the ids are cleared with it (`purgePlaidItemData`).
  plaidTransactionId String?
  plaidItemId        String?
  plaidAccountRowId  String?
  /// Denormalised on purpose — the badge must still name the bank after the item is unlinked
  /// and the PlaidItem row is gone.
  institutionName    String?
  verifiedAt         DateTime                      @default(now())
  /// Plaid said the bank record disappeared. Never deletes the user's Transaction.
  removedByPlaidAt   DateTime?
  /// The PlaidItem was unlinked; the badge says so rather than implying a live link.
  itemRemovedAt      DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// A bank record may back at most one transaction. SQLite treats NULLs as distinct, so any
  /// number of restored rows with a NULL plaidTransactionId coexist — which is exactly why
  /// the column is nullable.
  @@unique([userId, plaidTransactionId])
  @@index([userId])
}

/// A user-defined rule: when a transaction's title (and optionally amount, account and type)
/// matches, fill in category, title, amount, account and/or note. Evaluated by the pure engine
/// in src/lib/transaction-rules.ts — as suggestions on the manual forms and the Plaid review
/// queue, per row on CSV import, and on demand against past transactions.
///
/// A new table, so it needs no REQUIRED_SCHEMA_COLUMNS / COLUMN_REPAIRS entry.
model TransactionRule {
  id       String  @id @default(cuid())
  userId   String
  /// Lower runs first. Each action field is filled by the first matching rule that sets it.
  priority Int
  enabled  Boolean @default(true)

  titleOperator   TransactionRuleTextOperator
  titlePattern    String
  /// NULL matches both expenses and income.
  transactionType TransactionType?
  matchAccountId  String?
  /// Compared against the absolute amount, so a refund (a negative expense) matches the same
  /// rule as the original charge and lands in the same category.
  minAmountCents  Int?
  maxAmountCents  Int?

  setCategoryId  String?
  setTitle       String?
  setAmountCents Int?
  setAccountId   String?
  appendNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cascade: a rule scoped to an account that no longer exists would silently broaden.
  matchAccount Account?  @relation("TransactionRuleMatchAccount", fields: [matchAccountId], references: [id], onDelete: Cascade)
  /// SetNull: a rule must never block deleting a category or an account.
  setCategory  Category? @relation(fields: [setCategoryId], references: [id], onDelete: SetNull)
  setAccount   Account?  @relation("TransactionRuleSetAccount", fields: [setAccountId], references: [id], onDelete: SetNull)

  @@index([userId, priority])
}

/// A learned Title → Category combo the user asked to stop auto-filling. The combos themselves
/// are derived from transaction history on every load; only the opt-out is stored.
model HiddenTitleSuggestion {
  id        String   @id @default(cuid())
  userId    String
  /// `normalizeExpenseTitleKey(title)`.
  titleKey  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, titleKey])
}

/// An insight the user dismissed (`snoozedUntil` NULL) or snoozed. Insights themselves are
/// derived from transaction history on every load (src/lib/insights); only the opt-out is
/// stored, keyed by the insight's stable key — e.g. `recurring:EXPENSE:netflix`,
/// `habit:CANNABIS`.
///
/// A new table, so it needs no REQUIRED_SCHEMA_COLUMNS / COLUMN_REPAIRS entry.
model InsightDismissal {
  id           String    @id @default(cuid())
  userId       String
  insightKey   String
  /// NULL means dismissed for good; otherwise shown again once this passes.
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, insightKey])
}

/// Per-user insight settings. Its own table rather than a column on User for the same reason
/// as DashboardLayout: read by the insights loader alone, and a new table needs no column
/// repair entry. No row means the defaults.
model InsightPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  /// Tobacco, cannabis, alcohol, gambling and in-game purchase analysis. When off it is not
  /// computed at all, not merely hidden.
  habitDetectionEnabled Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
